%% Renamer — 架構圖（Mermaid flowchart TB）
%% 依實際程式碼繪製：src/Code.js, src/FileOperations.js, src/BatchRename.js, appsscript.json
%% Keystone：無後端伺服器／資料庫／第三方 API，全部跑在使用者自己的 Google 帳號內；
%% 且「套用規則」與「真正寫入 Drive」之間，隔著可手動編輯的「檔名變更區」預覽關卡。

flowchart TB

    subgraph L1["① 使用者介面層 — Google Sheets（活頁簿）"]
        UI1["指令區 工作表\nB2 來源資料夾 ‧ B3 目標資料夾\nB4 命名模式 ‧ B5 參數 ‧ B6 操作類型"]
        UI2["檔名變更區 工作表\nA原檔名 B原路徑 C變更後檔名(可編輯) D變更後路徑\nE類型 F大小 G修改時間"]
        MENU["自訂選單《檔案重新命名工具》\n讀取資料夾檔案／套用批次規則／開始重新命名／清除所有資料"]
    end

    subgraph L2["② 選單事件層 — src/Code.js"]
        E1["loadFolderFiles()"]
        E2["applyBatchRules()"]
        E3["startRenaming()\n含 YES/NO 確認對話框"]
        E4["clearAllData()\n含確認對話框"]
        ONOPEN["onOpen()\n建立自訂選單"]
    end

    subgraph L3["③ 命名規則運算層 — src/BatchRename.js（純函數，tests/ 可單元測試）"]
        R["applyBatchRename()\napplyRenameRule() 分派五種規則：\n新增文字・取代文字・大小寫轉換・新增序號・格式化日期"]
    end

    subgraph L4["④ 資料存取層 — src/FileOperations.js"]
        F1["getFolderIdFromSheet()\ngetFilesFromFolder()"]
        F2["populateFileList()\napplyRulesToExistingFiles()"]
        GATE{{"人工預覽關卡\n『檔名變更區』C欄可手動修改\n使用者確認無誤才點『開始重新命名』"}}
        F3["renameFile()\ncopyAndRenameFile()\ngetFileIdByNameAndPath()"]
    end

    subgraph L5["⑤ 外部服務層"]
        DRIVE[("Google Drive\n實際檔案儲存與重新命名")]
        GAS[["Google Apps Script V8 執行環境\ntimeZone: Asia/Taipei\n單次執行時間上限 6 分鐘"]]
    end

    ONOPEN --> MENU
    UI1 -- "讀取設定" --> E1
    MENU --> E1 --> F1 --> DRIVE
    F1 --> F2 --> UI2
    MENU --> E2
    UI1 -- "命名規則+參數" --> E2 --> R --> UI2
    UI2 --> GATE
    GATE -- "確認執行" --> E3
    MENU --> E3
    E3 --> F3 --> DRIVE
    MENU --> E4 --> UI2
    L2 -. "受限於" .-> GAS

    style GATE fill:#EAEEF7,stroke:#2E4B8F,stroke-width:2px,color:#181B20
    style DRIVE fill:#FBFAF7,stroke:#6B7178,stroke-width:1px
    style GAS fill:#FBFAF7,stroke:#6B7178,stroke-width:1px,stroke-dasharray: 3 3
